# Copy this file to .env and fill in your real values.
# .env is gitignored and stays local — never put real credentials in THIS
# file, since .env.example IS meant to be committed to Git.

# Brevo transactional email API (https://app.brevo.com) — used instead of
# SMTP because Render's free tier blocks outbound SMTP ports entirely.
# 1. Sign up free at brevo.com
# 2. Settings -> SMTP & API -> API Keys -> generate a new key -> BREVO_API_KEY
# 3. Senders, Domains & Dedicated IPs -> Senders -> add and verify your
#    Gmail address (just click the confirmation link Brevo emails you) -> BREVO_SENDER_EMAIL
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=youraddress@gmail.com
BREVO_SENDER_NAME=Pantry List
